# --- Postgres ---
POSTGRES_DB=sportlink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=dev

# --- JWT ---
SECURITY_JWT_SECRET=change-me-very-long-random-secret-32b-min
SECURITY_JWT_EXPIRATIONMS=86400000

# --- Nextcloud ---
NEXTCLOUD_BASE_URL=http://nextcloud
NEXTCLOUD_USER=sportlink
NEXTCLOUD_PASSWORD=Sportlink123!
NEXTCLOUD_AVATARS_ROOT=/remote.php/dav/files/sportlink/SportLink/avatars

# --- App files ---
APP_FILES_ROOT=/tmp/sportlink-files

# --- Bootstrap admin (создастся при старте, если админов ещё нет) ---
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@sport.link
BOOTSTRAP_ADMIN_PASSWORD=admin12345
BOOTSTRAP_ADMIN_NAME=Admin